# PHPStan configuration for Migrations Kit Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    # worker-strict includes ruleset-worker.neon (do not also include worker — duplicate include error).
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    reportUnmatchedIgnoredErrors: false
