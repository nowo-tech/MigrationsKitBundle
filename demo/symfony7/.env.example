# APP_ENV: Symfony environment. Use "dev" for local development.
APP_ENV=dev

# APP_DEBUG: Enable verbose debugging output in development.
APP_DEBUG=1

# APP_SECRET: Local-only secret used by Symfony internals.
APP_SECRET=change_this_secret_key_to_a_random_value

# DATABASE_URL: Database connection used by the demo.
# Default points to MySQL container on the Docker network.
DATABASE_URL="mysql://app:app@mysql:3306/demo"

# PORT: Host port mapped to FrankenPHP container port 80.
PORT=8007

# DEFAULT_URI: Canonical URI opened after `make up`.
DEFAULT_URI=http://localhost:8007
