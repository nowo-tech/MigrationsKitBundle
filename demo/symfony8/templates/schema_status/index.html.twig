{% extends 'base.html.twig' %}

{% block title %}Schema sync status – Migrations Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Schema sync status',
        intro: 'This page shows whether entity mappings are in sync with the database schema.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Status', kind: 'detail', in_sync: in_sync} %}
        {% block section_actions %}
            {% if in_sync %}<span class="nowo-ui-badge nowo-ui-badge--success">In sync</span>{% else %}<span class="nowo-ui-badge nowo-ui-badge--danger">Out of sync</span>{% endif %}
        {% endblock %}
        {% block section_body %}
            {% if in_sync %}
                <p><strong>Entities are in sync with the database.</strong></p>
                <p>All migrations have been applied and the Doctrine entities match the current schema.</p>
            {% else %}
                <p><strong>Entities are not in sync with the database.</strong></p>
                <p>Run migrations to create or update the database schema:</p>
                <pre class="nowo-ui-code-block" tabindex="0"><code>php bin/console doctrine:migrations:migrate --no-interaction</code></pre>
                <p>Or with Docker: <code>make migrate</code> from the demo directory.</p>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% if not in_sync and mapping_errors|length > 0 %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Mapping errors', kind: 'list', mapping_errors: mapping_errors} %}
            {% block section_body %}
                <ul>
                    {% for error in mapping_errors %}
                        <li><code>{{ error }}</code></li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% if not in_sync and schema_errors|length > 0 %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Schema errors (DB vs entities)', kind: 'list', schema_errors: schema_errors} %}
            {% block section_body %}
                <ul>
                    {% for error in schema_errors %}
                        <li><code>{{ error }}</code></li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
