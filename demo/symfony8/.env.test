# APP_ENV: Test environment for automated checks.
APP_ENV=test

# APP_DEBUG: Keep disabled in tests unless a debug run is required.
APP_DEBUG=0

# APP_SECRET: Test-only secret.
APP_SECRET=test_secret_for_migrations_kit_demo

# DATABASE_URL: MySQL database of the demo Compose stack (service `mysql`, same credentials as .env.example).
DATABASE_URL=mysql://app:app@mysql:3306/demo?serverVersion=8.4&charset=utf8mb4
