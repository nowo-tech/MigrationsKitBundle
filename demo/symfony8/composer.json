{
  "name": "nowo-tech/migrations-kit-demo-symfony8",
  "description": "Demo for Migrations Kit Bundle - Symfony 8",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4,<8.6",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/migrations": "^3.5",
    "doctrine/orm": "^3.4",
    "nowo-tech/migrations-kit-bundle": "@dev",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/yaml": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/twig-bundle": "^8.0"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\FieldDictionary\\": "migrations/FieldDictionary/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "@php bin/console cache:clear"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "migrate": [
      "@php -r \"is_dir('var') || mkdir('var', 0755, true);\"",
      "@php scripts/ensure-database.php"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.*"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "/var/migrations-kit-bundle"
    }
  ],
  "minimum-stability": "dev",
  "require-dev": {
    "nowo-tech/twig-inspector-bundle": "v1.0.5",
    "symfony/debug-bundle": "8.1.x-dev",
    "symfony/web-profiler-bundle": "8.1.x-dev"
  }
}
