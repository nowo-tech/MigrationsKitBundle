###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# SQLite (default). For MySQL 8 tests use: make migrate-mysql (uses mysql://app:app@mysql:3306/demo)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
DATABASE_URL="mysql://app:app@mysql:3306/demo"
###< doctrine/doctrine-bundle ###

# Web server port (Docker: host port mapped to container 80)
PORT=8008

# MySQL 8 (for make migrate-mysql): host is "mysql" inside Docker
# MYSQL_PORT=3308
