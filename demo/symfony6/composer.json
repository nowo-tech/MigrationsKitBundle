{
  "name": "nowo-tech/migrations-kit-demo-symfony6",
  "description": "Demo for Migrations Kit Bundle - Symfony 6",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1,<8.6",
    "doctrine/doctrine-bundle": "^2.10",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/migrations": "^3.6",
    "doctrine/orm": "^2.15",
    "nowo-tech/migrations-kit-bundle": "@dev",
    "symfony/console": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/runtime": "^6.4",
    "symfony/yaml": "^6.4",
    "symfony/debug-bundle": "^6.4",
    "symfony/http-kernel": "^6.4",
    "symfony/twig-bundle": "^6.4",
    "symfony/web-profiler-bundle": "^6.4"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "@php bin/console cache:clear"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "migrate": [
      "@php -r \"is_dir('var') || mkdir('var', 0755, true);\"",
      "@php scripts/ensure-database.php",
      "@php bin/console doctrine:migrations:migrate --no-interaction"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "/var/migrations-kit-bundle",
      "options": {
        "symlink": true
      }
    }
  ],
  "minimum-stability": "dev"
}